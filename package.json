{
  "name": "wiramusframe",
  "productName": "WiramusFrame",
  "version": "0.2.0",
  "description": "Warframe için açık kaynak, Overwolf'suz yardımcı: relic ödül overlay'i, envanter, ustalık planı, market",
  "main": "dist-electron/main.js",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "tessdata": "node scripts/fetch-tessdata.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && electron . --dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "koffi": "^3.3.7",
    "lucide-react": "^1.69.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-only",
  "author": "Wiramus",
  "homepage": "https://github.com/Wiramuss/wiramusframe",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wiramuss/wiramusframe.git"
  }
}
